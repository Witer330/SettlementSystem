// SettlementSystem - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ 系统基础 ============

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("operator")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  parentId  Int?
  status    String   @default("active")
  createdAt DateTime @default(now())

  employees Employee[]
}

model JobType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  unitPrice Float    @default(0)  // 默认计件单价
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

// ============ 工资核算 ============

model Employee {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  departmentId Int?
  jobType      String?
  jobTypeId    Int?
  hourlyRate   Float?  // 时薪标准，仅有时薪工作时填写
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department      Department?           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTypeRef      JobType?              @relation(fields: [jobTypeId], references: [id], onDelete: Restrict)
  salaryBills     SalaryBill[]
  workLogs        WorkLog[]
  dailyRecords    DailyPieceRecord[]
  otherSalaries   OtherSalary[]
  salaryDetailItems SalaryDetailItem[]
  partnerSalespersons Partner[]
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  code          String   @unique
  category      String
  specification String?
  unit          String
  defaultUnit   String?  // 默认使用单位（基本单位或包装单位名称）
  price         Float    @default(0)
  unitPrice     Float    @default(0)  // 计件单价（工资核算用）
  stock         Float    @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  safeStock         Float    @default(0)
  bomItems          BillOfMaterial[]
  dailyPieceRecords  DailyPieceRecordItem[]
  productionOrders  ProductionOrder[]
  returnOrderItems   ReturnOrderItem[]
  salaryDetailItems   SalaryDetailItem[]
  salesItems         SalesItem[]
}

model BillOfMaterial {
  id        Int      @id @default(autoincrement())
  productId Int
  materialId Int
  quantity  Float
  createdAt DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  material Material  @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// 工时记录 - 用于时薪员工
model WorkLog {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime
  hours      Float
  hourlyRate Float?   // 覆盖员工的默认时薪，为空则使用员工档案的时薪
  remark     String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

// 工资明细单（批次维度，合并计件+计时+其他）
model SalaryDetailSheet {
  id        Int      @id @default(autoincrement())
  sheetNo   String   @unique
  batchDate DateTime @default(now())
  status    String   @default("draft")  // draft / approved
  creator   String?
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SalaryDetailItem[]
}

model SalaryDetailItem {
  id         Int      @id @default(autoincrement())
  sheetId    Int
  employeeId Int
  type       String   // piece / hourly / other
  date       DateTime
  productId  Int?
  quantity   Float?
  unitPrice  Float?
  hours      Float?
  amount     Float
  remark     String?

  sheet    SalaryDetailSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id])
  product  Product?          @relation(fields: [productId], references: [id])
}

// 其他工资 — 奖金、绩效、一次性任务费等
model OtherSalary {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime
  type       String   @default("task")  // bonus(奖金) / performance(绩效) / task(一次性任务)
  amount     Float
  remark     String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model SalaryBillDetail {
  id             Int      @id @default(autoincrement())
  billId         Int
  type           String   // hourly / piece
  date           DateTime
  productId      Int?
  quantity       Float
  unitPrice      Float
  amount         Float
  sourceRecordId Int?     // 来源记录ID（工时记录或计件记录）
  remark         String?
  createdAt      DateTime @default(now())

  bill        SalaryBill @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model SalaryBill {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  period      String   // 结算周期，如 "2024-04"

  // 时薪部分
  hourlyHours Float    @default(0)  // 总工时
  hourlyAmount Float   @default(0)  // 时薪金额

  // 计件部分
  pieceAmount Float    @default(0)  // 计件金额
  pieceCount  Int      @default(0)  // 总件数

  // 其他工资部分
  otherAmount Float    @default(0)  // 其他工资金额
  otherCount  Int      @default(0)  // 其他工资条数

  // 合计
  totalAmount Float

  status      String   @default("pending")  // pending / approved / issued
  approvedBy  Int?
  approvedAt  DateTime?
  issuedAt    DateTime?
  dataHash    String?  // 发放时生成的数据哈希，用于完整性校验
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee        @relation(fields: [employeeId], references: [id])
  details  SalaryBillDetail[]
}

// ============ 生产管理 ============

model ProductionOrder {
  id               Int      @id @default(autoincrement())
  orderNo          String   @unique
  salesOrderId     Int?
  productId        Int
  quantity         Float
  producedQuantity Float    @default(0)
  status           String   @default("pending")  // pending / processing / completed / cancelled
  pickingStale     Boolean  @default(false)  // BOM变更后领料单需重新生成
  startDate        DateTime?
  endDate          DateTime?
  remark           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salesOrder   SalesOrder?              @relation(fields: [salesOrderId], references: [id])
  product      Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  pickingItems ProductionPickingItem[]
  dailyRecords DailyPieceRecord[]
}

model ProductionPickingItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  materialId Int
  plannedQty Float    @default(0)  // BOM计划用量
  pickedQty  Float    @default(0)  // 实际领料量
  remark     String?
  createdAt  DateTime @default(now())

  order    ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

// ============ 应收应付 ============

model Receivable {
  id          Int      @id @default(autoincrement())
  orderNo     String   @unique
  partnerId   Int
  totalAmount Float
  status      String   @default("pending")  // pending / approved
  approvedBy  Int?
  approvedAt  DateTime?
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner Partner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  items   ReceivableItem[]
}

model ReceivableItem {
  id            Int      @id @default(autoincrement())
  receivableId  Int
  salesOrderId  Int
  amount        Float
  createdAt     DateTime @default(now())

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model Payable {
  id          Int      @id @default(autoincrement())
  orderNo     String   @unique
  partnerId   Int
  totalAmount Float
  status      String   @default("pending")  // pending / approved
  approvedBy  Int?
  approvedAt  DateTime?
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner Partner       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  items   PayableItem[]
}

model PayableItem {
  id              Int      @id @default(autoincrement())
  payableId       Int
  purchaseOrderId Int
  amount          Float
  createdAt       DateTime @default(now())

  payable       Payable       @relation(fields: [payableId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

// ============ 进销存 ============

model Partner {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  shortName   String?  // 简称
  contact     String?
  phone       String?
  email       String?  // 邮箱
  fax         String?  // 传真
  address     String?
  shippingAddress String? // 发货地址
  website     String?  // 网址
  region      String?  // 区域
  category    String?  // 分类
  level       String?  // 等级
  isCustomer  Boolean  @default(false)
  isSupplier  Boolean  @default(false)
  creditLimit Float    @default(0)
  defaultDiscount Float @default(100) // 默认折扣(%)
  salespersonId Int?   // 业务员
  legalPerson String?  // 法人
  registeredCapital Float? // 注册资本(万元)
  businessScope String? // 经营范围
  remark      String?  // 备注
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesOrders    SalesOrder[]
  receivables    Receivable[]
  purchaseOrders PurchaseOrder[]
  payables       Payable[]
  salesperson    Employee? @relation(fields: [salespersonId], references: [id])
  customFieldValues PartnerCustomFieldValue[]

  @@index([isCustomer])
  @@index([isSupplier])
}

model PartnerCustomField {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  type      String   @default("input") // input | number | select | textarea
  options   String?                   // select 选项 JSON 数组
  orderBy   Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values PartnerCustomFieldValue[]
}

model PartnerCustomFieldValue {
  id        Int      @id @default(autoincrement())
  partnerId Int
  fieldId   Int
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  field   PartnerCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([partnerId, fieldId])
}

model Material {
  id            Int      @id @default(autoincrement())
  name          String
  code          String   @unique
  category      String
  specification String?
  unit          String
  defaultUnit   String?  // 默认使用单位（基本单位或包装单位名称）
  barcode       String?
  safeStock     Float    @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bomItems       BillOfMaterial[]
  inventory      Inventory?
  inventoryLogs  InventoryLog[]
  purchaseItems  PurchaseItem[]
  pickingItems   ProductionPickingItem[]
}

model PurchaseOrder {
  id               Int      @id @default(autoincrement())
  partnerId        Int?
  salesOrderId     Int?
  orderNo          String   @unique
  totalAmount      Float
  status           String   @default("pending")
  remark           String?
  reserveInventory Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partner    Partner?     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder?  @relation(fields: [salesOrderId], references: [id])
  items      PurchaseItem[]
  payableItems PayableItem[]
}

model PurchaseItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  materialId      Int
  quantity        Float
  price           Float
  receivedQuantity Float    @default(0)
  createdAt       DateTime @default(now())

  order    PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

model SalesOrder {
  id               Int      @id @default(autoincrement())
  partnerId        Int?
  orderNo          String   @unique
  totalAmount      Float
  status           String   @default("pending")
  remark           String?
  reserveInventory Boolean  @default(true)
  orderDate        DateTime?
  businessType     String?
  deliveryMethod   String?
  salesperson      String?
  deliveryPerson   String?
  returnDate       DateTime?
  paymentMethod    String?
  contactInfo      String?
  customerRemark   String?
  creator          String?
  wholeDiscount    Float    @default(100)
  usePrepayment    Boolean  @default(false)
  shippingAddress  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  partner           Partner?           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  productionOrders  ProductionOrder[]
  purchaseOrders    PurchaseOrder[]
  returnOrders      ReturnOrder[]
  items             SalesItem[]
  receivableItems   ReceivableItem[]
}

model SalesItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  productId     Int
  quantity      Float
  price         Float
  shippedQuantity Float    @default(0)
  createdAt     DateTime @default(now())

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model ReturnOrder {
  id            Int      @id @default(autoincrement())
  salesOrderId  Int
  returnNo      String   @unique
  totalQuantity Float
  status        String   @default("confirmed") // confirmed=已确认退货, completed=已退款入库
  reason        String?
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesOrder SalesOrder        @relation(fields: [salesOrderId], references: [id])
  items      ReturnOrderItem[]
}

model ReturnOrderItem {
  id            Int    @id @default(autoincrement())
  returnOrderId Int
  salesItemId   Int
  productId     Int
  quantity      Float
  createdAt     DateTime @default(now())

  returnOrder ReturnOrder @relation(fields: [returnOrderId], references: [id])
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Inventory {
  id          Int      @id @default(autoincrement())
  materialId  Int      @unique
  quantity    Float    @default(0)
  reserved    Float    @default(0)
  lastUpdated DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
}

model InventoryLog {
  id            Int      @id @default(autoincrement())
  materialId    Int
  type          String
  quantity      Float
  status        String   @default("draft")  // draft / approved
  batchNo       String?  // 单据号，同一单号=同一批次
  pkgSpec       String?  // 包装规格，空则用基本单位
  unitRatio     Float?   // 包装换算比
  referenceType String?
  referenceId   Int?
  remark        String?
  createdAt     DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])
}

// 每日计件记录表
model DailyPieceRecord {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  date              DateTime
  totalAmount       Float    @default(0)
  productionOrderId Int?
  remark            String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee        Employee                @relation(fields: [employeeId], references: [id])
  productionOrder ProductionOrder?        @relation(fields: [productionOrderId], references: [id])
  items           DailyPieceRecordItem[]
}

// 每日计件明细表
model DailyPieceRecordItem {
  id        Int      @id @default(autoincrement())
  recordId  Int
  productId Int
  quantity  Int
  unitPrice Float    // 记录时的单价
  amount    Float    // 金额

  createdAt DateTime @default(now())

  record  DailyPieceRecord @relation(fields: [recordId], references: [id])
  product Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// ============ 系统设置 ============

model Setting {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  value        String
  type         String   @default("string") // string | number | boolean | json
  category     String   @default("general") // general | ui | workflow | dashboard | system
  defaultValue String?
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    Int?
  updatedBy    Int?
}

model SettingAuditLog {
  id         Int      @id @default(autoincrement())
  settingKey String
  oldValue   String?
  newValue   String?
  action     String   // update | create | delete
  userId     Int?
  userName   String?
  createdAt  DateTime @default(now())

  @@index([settingKey])
  @@index([createdAt])
}

// 通用操作审计日志 — 由 audit.middleware 自动写入
model OperationLog {
  id         Int      @id @default(autoincrement())
  module     String   // product / material / salesOrder ...
  entityType String   // 模型名
  entityId   String?  // 字符串以支持复合键/批量
  action     String   // create / update / delete / archive / restore
  method     String   // POST / PUT / PATCH / DELETE
  path       String   // 请求路径
  oldValue   String?  // JSON 字符串（中间件方案下通常为 null）
  newValue   String?  // JSON 字符串（响应 data 摘要）
  userId     Int?
  userName   String?
  ip         String?
  status     Int      // HTTP 响应状态
  createdAt  DateTime @default(now())

  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

// 包装规格 — 物料/产品各自的包装单位及换算比
model PkgSpec {
  id        Int     @id @default(autoincrement())
  ownerType String  // "material" 或 "product"
  ownerId   Int
  name      String  // 包装名称：小箱 / 中箱 / 大箱 / 包 / 托
  unitName  String  // 包装单位：箱 / 包 / 托
  ratio     Float   // 1包装 = N 基本单位
  isDefault Boolean @default(false)

  @@unique([ownerType, ownerId, name])
}
